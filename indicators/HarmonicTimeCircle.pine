//@version=6
// ═════════════════════════════════════════════════════════════════════════════
//  ICT HARMONIC TIME CIRCLE — TEMPORAL SALIENCE ENGINE
//
//  Implementation of the indicator architecture in:
//  "ICT Harmonic Time Circle — A Geometric and Musical Framework for Intraday
//   Temporal Salience" (research draft, 2026). See docs/MATH_SPEC.md.
//
//  Three-layer design (paper §11):
//    1. HIDDEN ENGINE   — NY phase mapping, node families (clock / Pythagorean
//                         / golden), circular distances, salience score S_T,
//                         comma residual χ, ICT window nesting depth N.
//    2. VISIBLE LAYER   — future-time rail, high-salience background bands,
//                         diagnostic panel, projected node lines (no repaint).
//    3. RESEARCH LEDGER — machine-readable alert() JSON records for the
//                         empirical validation program (docs/VALIDATION.md).
//
//  NON-NEGOTIABLE TRADING RULE (paper §10):
//  No order should be generated by time alone. A temporal node may increase
//  the weight of valid price evidence, but liquidity, market structure,
//  displacement and risk logic must remain independently satisfied.
//  This indicator therefore emits SALIENCE, never direction.
// ═════════════════════════════════════════════════════════════════════════════
indicator("ICT Harmonic Time Circle — Temporal Salience Engine", shorttitle = "HTC",
     overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100)

// ─────────────────────────────────────────────────────────────────────────────
//  0 · CONSTANTS
// ─────────────────────────────────────────────────────────────────────────────
string TZ_NY   = "America/New_York"           // all engine math is NY-local (DST-safe)
float  PHI     = 1.6180339887498949           // golden ratio φ
float  PHI3    = 4.2360679774997896           // φ³ (Descartes chain scale)
float  LN2     = math.log(2.0)

f_log2(float x) => math.log(x) / LN2

// Pythagorean comma as a temporal unit: 24·log2(3¹²/2¹⁹) = 0.4692002 h = 28m09.12s
var float COMMA_H = 24.0 * f_log2(math.pow(3.0, 12) / math.pow(2.0, 19))

// Golden phase pair, symmetric about noon: φ⁻² + φ⁻¹ = 1
var float GOLD_A  = 24.0 * (2.0 - PHI)        // 24·φ⁻² = 09:10:01.86
var float GOLD_B  = 24.0 * (PHI - 1.0)        // 24·φ⁻¹ = 14:49:58.14

string FAM_CLOCK = "CLOCK"
string FAM_PYTH  = "PYTH"
string FAM_GOLD  = "GOLD"

// ─────────────────────────────────────────────────────────────────────────────
//  1 · TYPES
// ─────────────────────────────────────────────────────────────────────────────
type Node
    float  t                                  // NY time-of-day in hours [0, 24)
    string name
    string fam                                // FAM_CLOCK | FAM_PYTH | FAM_GOLD

type Window
    float  s                                  // start, NY hours
    float  e                                  // end, NY hours (may exceed s by wrap)
    string name
    string kind                               // MACRO | SB | RANGE | KZ

// ─────────────────────────────────────────────────────────────────────────────
//  2 · INPUTS
// ─────────────────────────────────────────────────────────────────────────────
string G_FAM  = "Node families"
bool  enClock  = input.bool(true,  "Clock lattice (even hours, 12-TET)",      group = G_FAM)
float wClock   = input.float(0.6,  "  weight",   minval = 0, maxval = 1, step = 0.1, group = G_FAM, inline = "c")
float sigClock = input.float(15.0, "  σ (min)",  minval = 1, maxval = 60,             group = G_FAM, inline = "c",
     tooltip = "Gaussian bandwidth of the clock family in minutes. Salience kernel K = exp(-½(d/σ)²).")
bool  enPyth   = input.bool(true,  "Pythagorean lattice (pure ratios)",       group = G_FAM)
float wPyth    = input.float(1.0,  "  weight",   minval = 0, maxval = 1, step = 0.1, group = G_FAM, inline = "p")
float sigPyth  = input.float(10.0, "  σ (min)",  minval = 1, maxval = 60,             group = G_FAM, inline = "p")
bool  enGold   = input.bool(true,  "Golden / Fibonacci pair (φ⁻², φ⁻¹)",      group = G_FAM)
float wGold    = input.float(1.0,  "  weight",   minval = 0, maxval = 1, step = 0.1, group = G_FAM, inline = "g")
float sigGold  = input.float(7.0,  "  σ (min)",  minval = 1, maxval = 60,             group = G_FAM, inline = "g")

string G_WIN  = "Registered ICT windows (NY time, HHMM-HHMM, comma-separated)"
bool   enMacros = input.bool(true, "Macros", group = G_WIN)
string cfgMacros = input.string("0233-0300,0403-0430,0850-0910,0950-1010,1150-1210,1310-1340,1515-1545",
     "  macro set", group = G_WIN, tooltip = "Fixed macro boundaries. No spaces. Era-dependent entries should be verified against primary ICT sources (paper §3, §13).")
bool   enSB     = input.bool(true, "Silver Bullets", group = G_WIN)
string cfgSB    = input.string("0300-0400,1000-1100,1400-1500", "  SB set", group = G_WIN)
bool   enRanges = input.bool(true, "CBDR / Asian ranges", group = G_WIN)
string cfgRanges = input.string("1400-2000,2000-2400", "  range set", group = G_WIN,
     tooltip = "14:00–20:00 CBDR + 20:00–24:00 Asian: the exact tangent-circle decomposition of the 14:00–24:00 parent arc (paper §6).")
bool   enKZ     = input.bool(false, "Kill zones (era-dependent)", group = G_WIN)
string cfgKZ    = input.string("0200-0500,0700-1000,1330-1600", "  KZ set", group = G_WIN)

string G_SAL  = "Salience & price-evidence gate"
float qThresh  = input.float(0.60, "High-salience threshold S_T ≥", minval = 0, maxval = 1, step = 0.05, group = G_SAL)
bool  reqWin   = input.bool(true,  "Qualified events require an active ICT window", group = G_SAL)
float dispMult = input.float(1.5,  "Displacement gate: |body| ≥ ATR ×", minval = 0.1, step = 0.1, group = G_SAL,
     tooltip = "Minimal price-evidence proxy. A 'qualified' state additionally requires this displacement — time alone never qualifies (paper §10).")
int   atrLen   = input.int(14,     "ATR length", minval = 1, group = G_SAL)

string G_VIS  = "Visible layer"
bool   showRail  = input.bool(true,  "Future-time rail", group = G_VIS)
int    railCount = input.int(4, "  nodes on rail", minval = 2, maxval = 6, group = G_VIS)
bool   showDiag  = input.bool(true,  "Diagnostic panel", group = G_VIS)
bool   showLines = input.bool(true,  "Projected node lines", group = G_VIS)
float  lookaheadH = input.float(6.0, "  line look-ahead (hours)", minval = 1, maxval = 24, group = G_VIS)
bool   showBG    = input.bool(true,  "Background band when S_T ≥ threshold inside active window", group = G_VIS)
bool   showDesc  = input.bool(false, "Descartes duration hierarchy panel (D_n = 24/[φ³(n²+2)])", group = G_VIS)
bool   markHits  = input.bool(true,  "Mark historical node hits", group = G_VIS)
color  colClock  = input.color(color.gray,                  "Clock",  group = G_VIS, inline = "col")
color  colPyth   = input.color(color.rgb(33, 118, 189),    "Pyth",   group = G_VIS, inline = "col")
color  colGold   = input.color(color.rgb(212, 165, 30),    "Gold",   group = G_VIS, inline = "col")
color  colBG     = input.color(color.rgb(126, 87, 194),    "Band",   group = G_VIS, inline = "col")

string G_ALT  = "Alerts & research ledger"
float leadMin   = input.float(5.0, "Approach alert lead (minutes)", minval = 1, maxval = 60, group = G_ALT)
bool  ledgerOn  = input.bool(false, "Emit research-ledger JSON on qualified events (alert() → webhook)", group = G_ALT,
     tooltip = "Schema in docs/VALIDATION.md. Feed a webhook to build the event ledger for the empirical validation program (paper §12).")

// ─────────────────────────────────────────────────────────────────────────────
//  3 · HIDDEN ENGINE — node registry (built once)
// ─────────────────────────────────────────────────────────────────────────────
f_wrap24(float x) => ((x % 24.0) + 24.0) % 24.0
f_ratioTime(float r) => f_wrap24(24.0 * f_log2(r))          // T(r) = 24·log2(r) mod 24

var array<Node>   nodes = array.new<Node>()
var array<Window> wins  = array.new<Window>()

f_pad2(int n) => (n < 10 ? "0" : "") + str.tostring(n)

f_fmtHMS(float h) =>
    int tot = int(math.round(f_wrap24(h) * 3600.0))
    tot := tot >= 86400 ? tot - 86400 : tot
    f_pad2(int(math.floor(tot / 3600.0))) + ":" + f_pad2(int(math.floor((tot % 3600) / 60.0))) + ":" + f_pad2(tot % 60)

f_fmtHM(float h) =>
    int tot = int(math.round(f_wrap24(h) * 60.0))
    tot := tot >= 1440 ? tot - 1440 : tot
    f_pad2(int(math.floor(tot / 60.0))) + ":" + f_pad2(tot % 60)

// duration in hours → "1h23m" / "12m05s"
f_fmtDur(float h) =>
    int tot = int(math.round(math.abs(h) * 3600.0))
    tot >= 3600 ? str.tostring(int(tot / 3600)) + "h" + f_pad2(int((tot % 3600) / 60)) + "m" :
     str.tostring(int(tot / 60)) + "m" + f_pad2(tot % 60) + "s"

f_parseHHMM(string tok) =>
    float out = na
    if str.length(tok) >= 4
        float hh = str.tonumber(str.substring(tok, 0, 2))
        float mm = str.tonumber(str.substring(tok, 2, 4))
        if not na(hh) and not na(mm)
            out := hh + mm / 60.0
    out

f_addWindows(string cfg, string kind) =>
    array<string> items = str.split(cfg, ",")
    if array.size(items) > 0
        for i = 0 to array.size(items) - 1
            array<string> ends = str.split(array.get(items, i), "-")
            if array.size(ends) == 2
                float s = f_parseHHMM(array.get(ends, 0))
                float e = f_parseHHMM(array.get(ends, 1))
                if not na(s) and not na(e)
                    array.push(wins, Window.new(s, e, kind + " " + f_fmtHM(s), kind))

if barstate.isfirst
    // Clock lattice: even hours ≡ 12-TET (2 h = 100 cents). Paper §2.
    for h = 0 to 22 by 2
        array.push(nodes, Node.new(float(h), f_pad2(h) + ":00", FAM_CLOCK))
    // Pure Pythagorean lattice: T(r) = 24·log2(r). Paper §3, Appendix A.
    array.push(nodes, Node.new(f_ratioTime(9.0 / 8.0),      "Pyth M2 9/8",      FAM_PYTH))   // 04:04:42
    array.push(nodes, Node.new(f_ratioTime(81.0 / 64.0),    "Pyth M3 81/64",    FAM_PYTH))   // 08:09:23
    array.push(nodes, Node.new(f_ratioTime(4.0 / 3.0),      "P4 4/3",           FAM_PYTH))   // 09:57:39
    array.push(nodes, Node.new(f_ratioTime(1024.0 / 729.0), "Pyth d5 1024/729", FAM_PYTH))   // 11:45:55
    array.push(nodes, Node.new(12.0,                        "TT √2",            FAM_PYTH))   // 12:00:00 exact
    array.push(nodes, Node.new(f_ratioTime(729.0 / 512.0),  "Pyth A4 729/512",  FAM_PYTH))   // 12:14:05
    array.push(nodes, Node.new(f_ratioTime(3.0 / 2.0),      "P5 3/2",           FAM_PYTH))   // 14:02:21
    array.push(nodes, Node.new(f_ratioTime(128.0 / 81.0),   "Pyth m6 128/81",   FAM_PYTH))   // 15:50:37
    array.push(nodes, Node.new(f_ratioTime(16.0 / 9.0),     "Pyth m7 16/9",     FAM_PYTH))   // 19:55:18
    array.push(nodes, Node.new(f_ratioTime(243.0 / 128.0),  "Pyth M7 243/128",  FAM_PYTH))   // 22:11:44
    // Golden pair, symmetric about noon. Paper §4.
    array.push(nodes, Node.new(GOLD_A, "Golden φ⁻²", FAM_GOLD))                              // 09:10:02
    array.push(nodes, Node.new(GOLD_B, "Golden φ⁻¹", FAM_GOLD))                              // 14:49:58
    // Registered ICT windows (empirical layer, kept separate from node math).
    if enMacros
        f_addWindows(cfgMacros, "Macro")
    if enSB
        f_addWindows(cfgSB, "SB")
    if enRanges
        f_addWindows(cfgRanges, "Range")
    if enKZ
        f_addWindows(cfgKZ, "KZ")

f_famEnabled(string fam) =>
    fam == FAM_CLOCK ? enClock : fam == FAM_PYTH ? enPyth : enGold

f_famColor(string fam) =>
    fam == FAM_CLOCK ? colClock : fam == FAM_PYTH ? colPyth : colGold

// ─────────────────────────────────────────────────────────────────────────────
//  4 · HIDDEN ENGINE — per-bar phase state
// ─────────────────────────────────────────────────────────────────────────────
// NY time-of-day in hours. Using the exchange-independent IANA zone makes the
// engine DST-safe by construction (paper §13, "DST/session handling").
float nyH = hour(time, TZ_NY) + minute(time, TZ_NY) / 60.0 + second(time, TZ_NY) / 3600.0

// signed circular offset t−node wrapped to (−12, 12]; distance is its magnitude
f_signed(float t, float n) =>
    float raw = t - n
    raw - 24.0 * math.round(raw / 24.0)
f_cdist(float t, float n) => math.abs(f_signed(t, n))

// nearest node per family + global nearest + nearest harmonic (Pyth ∪ Gold)
float  dClock = 1e9
float  dPyth = 1e9
float  dGold = 1e9
float  bestD = 1e9
float  bestSigned = na
string bestName = "—"
string bestFam = FAM_CLOCK
float  harmSigned = na
float  harmD = 1e9
string harmName = "—"
float  etaNextH = 1e9
string etaNextName = "—"

if timeframe.isintraday
    for i = 0 to array.size(nodes) - 1
        Node n = array.get(nodes, i)
        if f_famEnabled(n.fam)
            float sd = f_signed(nyH, n.t)
            float d  = math.abs(sd)
            if n.fam == FAM_CLOCK
                dClock := math.min(dClock, d)
            else
                if n.fam == FAM_PYTH
                    dPyth := math.min(dPyth, d)
                else
                    dGold := math.min(dGold, d)
                if d < harmD                          // harmonic families only → χ
                    harmD := d
                    harmSigned := sd
                    harmName := n.name
            if d < bestD
                bestD := d
                bestSigned := sd
                bestName := n.name
                bestFam := n.fam
            float eta = f_wrap24(n.t - nyH)           // forward distance to node
            if eta < etaNextH
                etaNextH := eta
                etaNextName := n.name

// family kernels K_f = exp(-½(d/σ)²), d in minutes
f_kernel(float dH, float sigMin) => math.exp(-0.5 * math.pow(dH * 60.0 / sigMin, 2))
float kClock = enClock ? f_kernel(dClock, sigClock) : 0.0
float kPyth  = enPyth  ? f_kernel(dPyth,  sigPyth)  : 0.0
float kGold  = enGold  ? f_kernel(dGold,  sigGold)  : 0.0

// temporal salience S_T ∈ [0,1]: weight-normalized blend of family kernels
float wSum = (enClock ? wClock : 0) + (enPyth ? wPyth : 0) + (enGold ? wGold : 0)
float S_T  = wSum > 0 ? (wClock * kClock * (enClock ? 1 : 0) + wPyth * kPyth * (enPyth ? 1 : 0) + wGold * kGold * (enGold ? 1 : 0)) / wSum : 0.0

// confluence order: families simultaneously "hot" (paper §10, term N partly)
int confl = (kClock > 0.5 ? 1 : 0) + (kPyth > 0.5 ? 1 : 0) + (kGold > 0.5 ? 1 : 0)

// comma residual χ = signed offset to nearest harmonic node / C_time (paper §8)
float chi = harmD < 1e8 ? harmSigned / COMMA_H : na
// classify against registered low-order fractions {0, ±1/12, ±1/6, ±1/4, ±1/2}
f_chiClass(float x) =>
    string out = "unclassified"
    if not na(x)
        array<float> fr = array.from(0.0, 1.0 / 12.0, 1.0 / 6.0, 1.0 / 4.0, 1.0 / 2.0)
        array<string> nm = array.from("0", "1/12", "1/6", "1/4", "1/2")
        for i = 0 to array.size(fr) - 1
            if math.abs(math.abs(x) - array.get(fr, i)) <= 1.0 / 48.0
                out := (i == 0 ? "χ≈0" : (x >= 0 ? "χ≈+" : "χ≈−") + array.get(nm, i))
                break
    out
string chiClass = f_chiClass(chi)

// ICT window nesting depth N: how many registered windows contain t
f_inWindow(Window w, float t) =>
    w.s <= w.e ? (t >= w.s and t < w.e) : (t >= w.s or t < w.e)
int nActive = 0
string activeNames = ""
if timeframe.isintraday and array.size(wins) > 0
    for i = 0 to array.size(wins) - 1
        Window w = array.get(wins, i)
        if f_inWindow(w, nyH)
            nActive += 1
            activeNames := activeNames == "" ? w.name : nActive <= 2 ? activeNames + " · " + w.name : activeNames

// ─────────────────────────────────────────────────────────────────────────────
//  5 · PRICE-EVIDENCE GATE (minimal displacement proxy — never a signal)
// ─────────────────────────────────────────────────────────────────────────────
float atr  = ta.atr(atrLen)
float body = math.abs(close - open)
bool  displaced = not na(atr) and atr > 0 and body >= dispMult * atr

bool  salient   = timeframe.isintraday and S_T >= qThresh and (not reqWin or nActive > 0)
bool  qualified = salient and displaced

// node-hit detection: any enabled node crossed between the previous and current bar
f_crossed(float prevT, float curT, float nodeT) =>
    prevT <= curT ? (nodeT > prevT and nodeT <= curT) : (nodeT > prevT or nodeT <= curT)
bool   nodeHit = false
string hitName = ""
string hitFam  = FAM_CLOCK
if timeframe.isintraday and bar_index > 0
    float prevH = nyH[1]
    for i = 0 to array.size(nodes) - 1
        Node n = array.get(nodes, i)
        if f_famEnabled(n.fam) and f_crossed(prevH, nyH, n.t)
            nodeHit := true
            hitName := hitName == "" ? n.name : hitName + " + " + n.name
            hitFam  := n.fam

// ─────────────────────────────────────────────────────────────────────────────
//  6 · VISIBLE LAYER
// ─────────────────────────────────────────────────────────────────────────────
// 6.1 background band: only around active high-salience windows (paper §11.2)
bgcolor(showBG and salient ? color.new(colBG, int(92 - 32 * math.min(S_T, 1.0))) : na)

// 6.2 historical node-hit markers
plotshape(markHits and nodeHit, "Node hit", style = shape.diamond, location = location.top,
     size = size.tiny, color = f_famColor(hitFam))

// 6.3 data-window diagnostics (hidden from pane)
plot(S_T * 100.0, "S_T (0–100)",        display = display.data_window)
plot(chi,         "χ comma residual",   display = display.data_window)
plot(nActive,     "Window nesting N",   display = display.data_window)
plot(confl,       "Confluence order",   display = display.data_window)

// 6.4 projected node lines + future-time rail + panels — last bar only, so the
//     projection is deterministic and non-repainting (nodes are fixed times).
var array<line>  vLines  = array.new<line>()
var array<label> vLabels = array.new<label>()
var table railTbl = table.new(position.top_center, 7, 4, border_width = 1)
var table diagTbl = table.new(position.top_right, 2, 9, border_width = 1)
var table descTbl = table.new(position.bottom_right, 3, 8, border_width = 1)

f_nodeTimestamp(float nodeT) =>
    // timestamp of the NEXT occurrence of nodeT (NY time-of-day) after this bar
    int tot = int(math.round(nodeT * 3600.0))
    int addDay = nodeT > nyH ? 0 : 1
    timestamp(TZ_NY, year(time, TZ_NY), month(time, TZ_NY), dayofmonth(time, TZ_NY) + addDay,
     int(math.floor(tot / 3600.0)), int(math.floor((tot % 3600) / 60.0)), tot % 60)

color TXT  = chart.fg_color
color CELL = color.new(chart.bg_color, 20)

f_row(int r, string k, string v, color vc) =>
    table.cell(diagTbl, 0, r, k, text_color = color.new(TXT, 35), bgcolor = CELL,
     text_size = size.tiny, text_halign = text.align_left)
    table.cell(diagTbl, 1, r, v, text_color = vc, bgcolor = CELL,
     text_size = size.small, text_halign = text.align_right)

if barstate.islast
    // clear previous projections
    if array.size(vLines) > 0
        for i = 0 to array.size(vLines) - 1
            line.delete(array.get(vLines, i))
        array.clear(vLines)
    if array.size(vLabels) > 0
        for i = 0 to array.size(vLabels) - 1
            label.delete(array.get(vLabels, i))
        array.clear(vLabels)
    table.clear(railTbl, 0, 0, 6, 3)
    table.clear(diagTbl, 0, 0, 1, 8)

    if not timeframe.isintraday
        table.cell(railTbl, 0, 0, "HTC: intraday timeframes only (engine idle on " + timeframe.period + ")",
         text_color = TXT, bgcolor = CELL, text_size = size.small)
    else
        // rank enabled nodes by forward distance
        array<float> etas = array.new_float()
        array<int>   ids  = array.new_int()
        for i = 0 to array.size(nodes) - 1
            Node n = array.get(nodes, i)
            if f_famEnabled(n.fam)
                array.push(etas, f_wrap24(n.t - nyH))
                array.push(ids, i)
        array<int> rankIdx = array.sort_indices(etas)

        // 6.4a future-time rail:  P4 09:57 → TT 12:00 → P5 14:02 → φ⁻¹ 14:50 …
        if showRail
            table.cell(railTbl, 0, 0, "NEXT", text_color = TXT, bgcolor = CELL, text_size = size.small)
            table.cell(railTbl, 0, 1, "node", text_color = color.new(TXT, 40), bgcolor = CELL, text_size = size.tiny)
            table.cell(railTbl, 0, 2, "NY time", text_color = color.new(TXT, 40), bgcolor = CELL, text_size = size.tiny)
            table.cell(railTbl, 0, 3, "in", text_color = color.new(TXT, 40), bgcolor = CELL, text_size = size.tiny)
            int shown = math.min(railCount, array.size(rankIdx))
            if shown > 0
                for c = 0 to shown - 1
                    int id = array.get(ids, array.get(rankIdx, c))
                    Node n = array.get(nodes, id)
                    float eta = array.get(etas, array.get(rankIdx, c))
                    color fc = f_famColor(n.fam)
                    table.cell(railTbl, c + 1, 0, "●", text_color = fc, bgcolor = CELL, text_size = size.small)
                    table.cell(railTbl, c + 1, 1, n.name, text_color = TXT, bgcolor = CELL, text_size = size.small)
                    table.cell(railTbl, c + 1, 2, f_fmtHMS(n.t), text_color = color.new(TXT, 25), bgcolor = CELL, text_size = size.tiny)
                    table.cell(railTbl, c + 1, 3, f_fmtDur(eta), text_color = fc, bgcolor = CELL, text_size = size.small)

        // 6.4b projected vertical lines within the look-ahead horizon
        if showLines and array.size(rankIdx) > 0
            for c = 0 to array.size(rankIdx) - 1
                float eta = array.get(etas, array.get(rankIdx, c))
                if eta <= lookaheadH
                    int id = array.get(ids, array.get(rankIdx, c))
                    Node n = array.get(nodes, id)
                    int ts = f_nodeTimestamp(n.t)
                    color fc = f_famColor(n.fam)
                    array.push(vLines, line.new(ts, low, ts, high, xloc = xloc.bar_time,
                     extend = extend.both, color = color.new(fc, 45),
                     style = n.fam == FAM_CLOCK ? line.style_dotted : line.style_solid, width = 1))
                    array.push(vLabels, label.new(ts, high, n.name + "\n" + f_fmtHM(n.t),
                     xloc = xloc.bar_time, style = label.style_label_down, textcolor = fc,
                     color = color.new(fc, 88), size = size.tiny))

        // 6.4c diagnostic panel (paper §11.2)
        if showDiag
            string stateTxt = qualified ? "QUALIFIED" : salient ? "SALIENT" : "QUIET"
            color  stateCol = qualified ? color.new(colGold, 0) : salient ? color.new(colBG, 0) : color.new(TXT, 45)
            f_row(0, "state", stateTxt, stateCol)
            f_row(1, "nearest node", bestName, f_famColor(bestFam))
            f_row(2, "offset", (bestSigned >= 0 ? "+" : "−") + f_fmtDur(math.abs(bestSigned)), TXT)
            f_row(3, "salience S_T", str.tostring(S_T, "#.00"), S_T >= qThresh ? color.new(colGold, 0) : TXT)
            f_row(4, "χ (comma)", na(chi) ? "—" : str.tostring(chi, "#.000") + "  " + chiClass, TXT)
            f_row(5, "χ vs node", harmName, color.new(TXT, 25))
            f_row(6, "windows N", str.tostring(nActive) + (activeNames == "" ? "" : "  " + activeNames), nActive > 0 ? color.new(colBG, 0) : color.new(TXT, 45))
            f_row(7, "confluence", str.tostring(confl) + " / 3 families", TXT)
            f_row(8, "displacement", displaced ? "yes  (" + str.tostring(body / atr, "#.0") + "×ATR)" : "no", displaced ? color.new(colGold, 0) : color.new(TXT, 45))

    // 6.4d Descartes duration hierarchy: D_n = 24/[φ³(n²+2)] h (paper §7.2)
    if showDesc
        table.cell(descTbl, 0, 0, "n", text_color = color.new(TXT, 40), bgcolor = CELL, text_size = size.tiny)
        table.cell(descTbl, 1, 0, "κR=n²+2", text_color = color.new(TXT, 40), bgcolor = CELL, text_size = size.tiny)
        table.cell(descTbl, 2, 0, "D (min)", text_color = color.new(TXT, 40), bgcolor = CELL, text_size = size.tiny)
        for dn = 1 to 6
            float dMin = 1440.0 / (PHI3 * (dn * dn + 2))
            table.cell(descTbl, 0, dn, str.tostring(dn), text_color = TXT, bgcolor = CELL, text_size = size.tiny)
            table.cell(descTbl, 1, dn, str.tostring(dn * dn + 2), text_color = TXT, bgcolor = CELL, text_size = size.tiny)
            table.cell(descTbl, 2, dn, str.tostring(dMin, "#.00"), text_color = colGold, bgcolor = CELL, text_size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
//  7 · ALERTS & RESEARCH LEDGER
// ─────────────────────────────────────────────────────────────────────────────
float etaNextMin = etaNextH * 60.0
bool approachTrig = timeframe.isintraday and etaNextMin <= leadMin and (na(etaNextMin[1]) or etaNextMin[1] > leadMin)

alertcondition(approachTrig,               "HTC · Node approaching", "Harmonic time node approaching within lead window")
alertcondition(nodeHit,                    "HTC · Node hit",         "Harmonic time node crossed")
alertcondition(qualified and not qualified[1], "HTC · Qualified temporal event", "High temporal salience + displacement inside registered window")

// Ledger record (paper §11.3): one JSON object per qualifying confirmed bar.
// Route via alert() → webhook to accumulate the empirical event ledger.
if ledgerOn and qualified and barstate.isconfirmed
    string js = "{" +
     "\"schema\":\"htc-ledger-1\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"tf\":\"" + timeframe.period + "\"," +
     "\"bar_time_utc\":" + str.tostring(time) + "," +
     "\"ny_tod\":\"" + f_fmtHMS(nyH) + "\"," +
     "\"phase\":" + str.tostring(nyH / 24.0, "#.######") + "," +
     "\"nearest_node\":\"" + bestName + "\"," +
     "\"family\":\"" + bestFam + "\"," +
     "\"offset_min\":" + str.tostring(bestSigned * 60.0, "#.###") + "," +
     "\"chi\":" + (na(chi) ? "null" : str.tostring(chi, "#.####")) + "," +
     "\"chi_class\":\"" + chiClass + "\"," +
     "\"salience\":" + str.tostring(S_T, "#.####") + "," +
     "\"confluence\":" + str.tostring(confl) + "," +
     "\"nesting\":" + str.tostring(nActive) + "," +
     "\"displacement_atr\":" + str.tostring(body / atr, "#.###") + "," +
     "\"o\":" + str.tostring(open) + ",\"h\":" + str.tostring(high) +
     ",\"l\":" + str.tostring(low) + ",\"c\":" + str.tostring(close) + "}"
    alert(js, alert.freq_once_per_bar_close)
